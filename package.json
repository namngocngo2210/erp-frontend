{
  "name": "desi-order-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "//engines": "Node 24 làm 2 test RequireAuth đỏ giả (undici siết kiểm tra AbortSignal, react-router dính phải). CI chạy Node 22 — dev nên dùng cùng bản để không đuổi theo lỗi ma.",
  "//engines-zxing": "@zxing/library@0.22 (dep của @zxing/browser) khai engines node>=24 → npm cảnh báo EBADENGINE trên Node 22, chỉ là cảnh báo (lib chạy trong trình duyệt, không dùng API Node). Không pin bản thấp hơn được vì @zxing/browser@0.2 kéo đúng bản này; nâng engines lên 24 chỉ khi đã sửa 2 test RequireAuth ở ghi chú trên (audit 2026-09-23 P3).",
  "engines": {
    "node": ">=22 <24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:watch": "vitest",
    "//gen:api": "Phải chạy prettier ngay sau khi sinh: openapi-typescript xuất thụt 4 space, còn file trong repo đã qua prettier (2 space). Thiếu bước này thì job drift-check của CI luôn đỏ dù nội dung không đổi.",
    "gen:api": "openapi-typescript ../backend/schema.yaml -o src/api/schema.d.ts && prettier --write src/api/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "lint": "eslint src --max-warnings=0",
    "lint:strict": "eslint src --max-warnings=0",
    "lint:loose": "eslint src --max-warnings=9999",
    "//lint:dead": "knip: file/export/dependency không ai dùng (audit 2026-09-23 P1-3). Đỏ = có code chết mới hoặc export thừa; cấu hình ở knip.json.",
    "lint:dead": "knip --no-progress",
    "prepare": "cd .. && git config core.hooksPath frontend/.husky && husky frontend/.husky || true"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.css": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/be-vietnam-pro": "^5.2.8",
    "@sentry/react": "^10.63.0",
    "@tanstack/react-query": "^5.100.14",
    "@xyflow/react": "^12.11.2",
    "@zxing/browser": "^0.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.511.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.9.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "knip": "^6.37.0",
    "lint-staged": "^15.5.2",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.60.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.6"
  }
}
